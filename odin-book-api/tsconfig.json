{
  "compilerOptions": {
    "module": "nodenext",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@auth/*": ["./src/auth/*"],
      "@users/*": ["./src/users/*"],
      "@profiles/*": ["./src/profiles/*"],
      "@social/*": ["./src/social/*"],
      "@content/*": ["./src/content/*"],
      "@feed/*": ["./src/feed/*"],
      "@storage/*": ["./src/storage/*"]
    },
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}
